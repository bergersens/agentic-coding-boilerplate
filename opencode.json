{
  "$schema": "https://opencode.ai/config.json",
  "instructions": ["AGENTS.md"],
  "default_agent": "product",
  "permission": {
    "edit": "allow",
    "bash": {
      "*": "allow",
      "git push*": "ask",
      "git reset --hard*": "ask",
      "rm -rf *": "deny"
    },
    "external_directory": {
      "/tmp/**": "allow",
      "/var/folders/**": "allow"
    }
  }
}
